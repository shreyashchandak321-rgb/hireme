NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_PRODUCT_NAME=CareerPilot
NEXT_PUBLIC_SITE_TITLE=CareerPilot
NEXT_PUBLIC_SITE_DESCRIPTION=Your job search workspace
NEXT_PUBLIC_SUPABASE_URL=https://qdklvizpjhkfgvhtbhch.supabase.co
# Existing variable name; the publishable key is supported.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_O9pL3LubJp_b6ZpxES26XA_uxDTw35y
# REQUIRED: set privately in Vercel. Never commit the actual value.
# A legacy service_role JWT or new sb_secret key is accepted by the cloud adapter.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_AUTH_PASSWORD=true
NEXT_PUBLIC_AUTH_GOOGLE=false
NEXT_PUBLIC_ENABLE_PERSONAL_ACCOUNT_DELETION=false
